NODE_ENV=development
PORT=3001

# reprendre strictement le nom du service docker MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=solidays_dev

# URL de l'API : vide = même adresse que le site (Vite relaie /api vers Express)
VITE_API_URL=

# origines autorisées - CORS
ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# dossier public (images des artistes envoyées depuis l'admin)
PUBLIC_DIR=public

# clé de signature des sessions admin (32 caractères minimum)
# générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
