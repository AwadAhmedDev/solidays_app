NODE_ENV=development
PORT=3001

# reprendre strictement le nom du service docker MySQL
MYSQL_HOST=mysql
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=solidays_dev

# URL de l'API
# si la variable doit être utilisée dans vite, il est nécéssaire de préfixer la variable par VITE_
VITE_API_URL=http://127.0.0.1:3001

# origines autorisées - CORS
ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# dossier public
PUBLIC_DIR=public